          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n    datetime AS \"time\", \r\n    MAX((value->>'value')::NUMERIC) FILTER (WHERE \"point\" = 'TmpAmb') AS \"Temperatura\",\r\n    MAX((value->>'value')::NUMERIC) FILTER (WHERE \"point\" = 'RH') AS \"Umidade\"\r\nFROM environmental_data\r\nWHERE \r\n    \"point\" IN ('TmpAmb', 'RH')\r\n    AND datetime > (${__from} / 1000) \r\n    AND datetime < (${__to} / 1000)\r\nGROUP BY datetime\r\nORDER BY datetime;\r\n",
